{
  "name": "karasu/karasu-buyers-club",
  "description": "Karasu Buyers Club — Loyalty & Rewards Plugin for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "version": "0.5.0",
  "authors": [
    {
      "name": "Karasu Team"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "KarasuBuyersClub\\": "includes/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
